# PromptSite 환경변수 예시 — .env.local 로 복사해서 값을 채우세요.
# 키를 비워두면 AI 코어가 자동으로 목(mock) 응답 모드로 동작합니다.

# ── AI 프로바이더 키 ──
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── (선택) 모델 ID override — 기본값은 lib/ai/config.ts ──
# ANTHROPIC_MODEL_PRIMARY=claude-opus-4-8
# ANTHROPIC_MODEL_SECONDARY=claude-sonnet-4-6
# GEMINI_MODEL_PRIMARY=gemini-3.1-pro
# GEMINI_MODEL_SECONDARY=gemini-3.5-flash
# OPENAI_TEXT_MODEL=gpt-5.1

# ── (선택) 호출 동작 override ──
# AI_TIMEOUT_MS=60000
# AI_MAX_RETRIES=1
# AI_RETRY_BACKOFF_MS=800

# ── 강제 목 모드 ──
# PROMPTSITE_MOCK=1

# ── 통합 라이선스(코드발급) 시스템 ──
# 관리 화면(/admin/licenses)과 봇 검증 API(/api/license/verify)에 필요.
# Supabase URL/anon 키(위)에 더해 service_role 키와 관리자 이메일이 있어야 켜진다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # 서버 전용. 절대 클라이언트 노출 금지.
LICENSE_ADMIN_EMAILS=            # 라이선스 관리자 이메일(쉼표 구분). 예: me@example.com,ops@example.com
# 봇 6개의 id:이름 (미지정 시 bot1..bot6 기본). 예: kakao:카카오봇,insta:인스타봇,...
# LICENSE_BOTS=bot1:봇 1,bot2:봇 2,bot3:봇 3,bot4:봇 4,bot5:봇 5,bot6:봇 6
