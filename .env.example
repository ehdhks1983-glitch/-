# 머무는순간(StayClip) 환경변수 예시 — .env.local 로 복사해서 값을 채우세요.
# 키가 전부 비어 있어도 사이트는 빌드/구동됩니다(신청 접수만 비활성화).

# ── Supabase (신청 접수 · 운영자 로그인) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 서버 전용: 운영자(/admin) 신청 목록 조회용. 절대 클라이언트 노출 금지 ──
SUPABASE_SERVICE_ROLE_KEY=

# ── 운영자 이메일 화이트리스트(쉼표 구분). 등록된 계정만 /admin 접근 ──
# 예) ADMIN_EMAILS=owner@example.com,manager@example.com
ADMIN_EMAILS=
