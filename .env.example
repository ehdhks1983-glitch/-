# 곰대리 멀티발행 — 환경변수 예시. .env.local 로 복사해 값을 채우세요.
# 규칙(스펙 §13/§14): 비밀값은 전부 env, 기본 빈 문자열, 저장소 커밋 금지. AI 키는 서버에만.
# 키를 비워두면: AI=목(mock) 모드, Supabase=인증/저장/과금 비활성(코어 파이프라인은 인메모리로 동작).

# ── AI 프로바이더 (서버 전용, 클라이언트 노출 금지) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Supabase (Postgres + Auth) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 워커가 RLS 우회로 과금/저장할 때 사용(서버 전용, 절대 클라이언트 금지).
SUPABASE_SERVICE_ROLE_KEY=

# ── (선택) 모델 ID override — 기본값은 lib/config/models.ts ──
# ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5
# ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6

# ── (선택) 단가 override (per MTok USD) — 기본 Haiku 1/5, Sonnet 3/15 ──
# PRICE_HAIKU_IN=1
# PRICE_HAIKU_OUT=5
# PRICE_SONNET_IN=3
# PRICE_SONNET_OUT=15

# ── (선택) 게이트웨이 호출 동작 ──
# AI_TIMEOUT_MS=60000
# AI_MAX_RETRIES=2
# AI_RETRY_BACKOFF_MS=800

# ── (선택) 워커 ──
# WORKER_POLL_MS=1500          # 잡 폴링 주기
# WORKER_CONCURRENCY=2         # 동시 처리 잡 수

# ── 강제 목 모드 (키 있어도 mock) ──
# GOMDAERI_MOCK=1

# ── P2 (이번 MVP 범위 밖) ──
# PORTONE_API_KEY=
# PORTONE_API_SECRET=
